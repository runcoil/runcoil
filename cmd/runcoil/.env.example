AUTO_MIGRATE=false

LOG_LEVEL=info
LOG_FORMAT=text

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=10

API_PORT=8080
API_SECURE_COOKIE=false
API_SWAGGER=false

DISPATCHER_PORT=7070
DISPATCHER_CLAIM_INTERVAL=1s
DISPATCHER_HEARTBEAT_INTERVAL=10s
DISPATCHER_WORKER_TTL=30s

RETRY_MAX_ATTEMPTS=4
RETRY_DELAYS=5s,10s,30s,1m0s,3m0s,10m0s,30m0s,1h0m0s
RETRY_JITTER=0.2

SCHEDULER_REQUEUE_DELAYED_RUNS_INTERVAL=1s
SCHEDULER_START_DEADLINE_CHECK_INTERVAL=1s
SCHEDULER_DEAD_WORKER_CHECK_INTERVAL=5s
SCHEDULER_SCHEDULE_CHECK_INTERVAL=1s

RUN_MAX_LOST_ATTEMPTS=5

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin

SESSION_MAX_LIFETIME=720h0m0s
SESSION_MAX_INACTIVE=168h0m0s
