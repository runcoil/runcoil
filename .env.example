HTTP_ADDR=:7070

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=runcoil
POSTGRES_PASSWORD=
POSTGRES_DB=runcoil
# libpq values: disable, prefer, require, verify-ca, verify-full.
POSTGRES_SSL_MODE=prefer
POSTGRES_MAX_CONNS=10

# debug, info, warn or error.
LOG_LEVEL=info
# text for a terminal, json for production.
LOG_FORMAT=text
