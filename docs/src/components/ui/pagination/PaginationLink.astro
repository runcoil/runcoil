---
/**
 * PaginationLink — one side of the pagination row: a caret, a caption, and
 * the page title (the default slot).
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";

interface Props extends Omit<HTMLAttributes<"a">, "rel"> {
  rel: "prev" | "next";
  href: string;
  /** Caption above the title. Defaults to "Previous" or "Next". */
  label?: string;
}

const { rel, href, label, class: className, ...attrs } = Astro.props;
const isNext = rel === "next";
const caption = label ?? (isNext ? "Next" : "Previous");
---

<a
  href={href}
  rel={rel}
  data-slot="pagination-link"
  class={cn(
    "group flex min-w-0 items-center gap-2 text-sm text-muted-foreground no-underline transition-colors hover:text-foreground",
    isNext && "ms-auto text-end",
    className,
  )}
  {...attrs}
>
  {!isNext && <Icon name="ph:caret-left" class="h-4 w-4 shrink-0 transition-transform group-hover:-translate-x-0.5 rtl:rotate-180" />}
  <span class="min-w-0">
    <span data-slot="pagination-label" class="block text-xs text-muted-foreground">{caption}</span>
    <span data-slot="pagination-title" class="font-medium text-foreground"><slot /></span>
  </span>
  {isNext && <Icon name="ph:caret-right" class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-0.5 rtl:rotate-180" />}
</a>
